{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/bamtofastq/dev/assets/schema_references.json",
    "title": "nf-core/bamtofastq references datasheet schema",
    "description": "Subset of nf-core/references schema_references.json for bamtofastq (--fasta / --fasta_fai plus reference meta)",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "genome": {
                "meta": ["genome", "id"],
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Genome name must be provided and cannot contain spaces"
            },
            "site": {
                "meta": ["site"],
                "type": "string",
                "pattern": "^\\S+$",
                "default": "unknown"
            },
            "source": {
                "meta": ["source"],
                "type": "string",
                "pattern": "^\\S+$"
            },
            "source_version": {
                "meta": ["source_version"],
                "type": "string",
                "pattern": "^\\S+$",
                "default": "unknown"
            },
            "species": {
                "meta": ["species"],
                "type": "string",
                "pattern": "^\\S+$"
            },
            "fasta": {
                "meta": ["fasta"],
                "type": "string",
                "pattern": "^\\S+\\.f(ast|n)?a(\\.gz)?$",
                "errorMessage": "Fasta must be an existing file ending in '.fa', '.fasta' or '.fna' that does not contain spaces. This file can be gzipped."
            },
            "fasta_fai": {
                "meta": ["fasta_fai"],
                "type": "string",
                "pattern": "^\\S+\\.f(ast|n)?a\\.fai(\\.gz)?$",
                "errorMessage": "Fasta index must end in a valid fasta extension followed by '.fai' and cannot contain spaces."
            },
            "readme": {
                "type": "string",
                "pattern": "^\\S+\\.(md|txt)$"
            }
        },
        "required": ["genome"]
    }
}
