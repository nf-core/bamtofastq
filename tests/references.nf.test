nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    tag "pipeline_bamtofastq"
    tag "cpu"

    test("-profile test | --references fasta and fasta_fai") {

        when {
            params {
                outdir     = "$outputDir"
                references = 'https://raw.githubusercontent.com/nf-core/references-datasheets/latest/genomes/Homo_sapiens/nf-core/GRCh38_chr21.yml'
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            def bam_files  = getAllFilesFromDir(params.outdir, include: ['**/*.bam'])
            def cram_files  = getAllFilesFromDir(params.outdir, include: ['**/*.cram'])
            def fasta       = 'https://raw.githubusercontent.com/nf-core/test-datasets/references/references/GRCh38_chr21/GRCh38_chr21.fa'
            assert workflow.success
            assertAll(
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    removeFromYamlMap("${outputDir}/pipeline_info/nf_core_bamtofastq_software_mqc_versions.yml", "Workflow"),
                    stable_name.isEmpty() ? 'No stable paths' : stable_name,
                    stable_path.isEmpty() ? 'No stable content' : stable_path,
                    bam_files.isEmpty() ? 'No BAM files' : bam_files.collect { file -> file.getName() + ":md5," +  bam(file.toString()).readsMD5 },
                    cram_files.isEmpty() ? 'No CRAM files' : cram_files.collect { file -> file.getName() + ":md5," +  cram(file.toString(), fasta).readsMD5 },
                ).match() }
            )
        }
    }

    test("-profile test | --genome + igenomes_ignore") {

        when {
            params {
                outdir               = "$outputDir"
                igenomes_ignore      = true
                references_base_path = 'https://raw.githubusercontent.com/nf-core/references-datasheets/latest/genomes/Homo_sapiens/nf-core'
                genome               = 'GRCh38_chr21'
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            def bam_files  = getAllFilesFromDir(params.outdir, include: ['**/*.bam'])
            def cram_files  = getAllFilesFromDir(params.outdir, include: ['**/*.cram'])
            def fasta       = 'https://raw.githubusercontent.com/nf-core/test-datasets/references/references/GRCh38_chr21/GRCh38_chr21.fa'
            assert workflow.success
            assertAll(
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    removeFromYamlMap("${outputDir}/pipeline_info/nf_core_bamtofastq_software_mqc_versions.yml", "Workflow"),
                    stable_name.isEmpty() ? 'No stable paths' : stable_name,
                    stable_path.isEmpty() ? 'No stable content' : stable_path,
                    bam_files.isEmpty() ? 'No BAM files' : bam_files.collect { file -> file.getName() + ":md5," +  bam(file.toString()).readsMD5 },
                    cram_files.isEmpty() ? 'No CRAM files' : cram_files.collect { file -> file.getName() + ":md5," +  cram(file.toString(), fasta).readsMD5 },
                ).match() }
            )
        }
    }
}
