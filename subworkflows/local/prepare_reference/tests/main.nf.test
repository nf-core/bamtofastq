nextflow_workflow {

    name "Test Workflow PREPARE_REFERENCE"
    script "../main.nf"
    workflow "PREPARE_REFERENCE"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/prepare_reference"
    tag "prepare_reference"

    tag "samtools"
    tag "samtools/faidx"

    test("sarscov2 - fasta - fasta_fai provided") {
        when {
            workflow {
                """
                input[0] = params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta'
                input[1] = params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai'
                """
            }
        }
        then {
            assert workflow.success
            assert snapshot(sanitizeOutput(workflow.out)).match()
        }
    }

    test("sarscov2 - fasta - build fai") {
        when {
            workflow {
                """
                input[0] = params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta'
                input[1] = null
                """
            }
        }
        then {
            assert workflow.success
            assert snapshot(sanitizeOutput(workflow.out)).match()
        }
    }

    test("human - fasta - build fai") {
        when {
            workflow {
                """
                input[0] = params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta'
                input[1] = null
                """
            }
        }
        then {
            assert workflow.success
            assert snapshot(sanitizeOutput(workflow.out)).match()
        }
    }

    test("no fasta - empty channels") {
        when {
            workflow {
                """
                input[0] = null
                input[1] = null
                """
            }
        }
        then {
            assert workflow.success
            assert snapshot(sanitizeOutput(workflow.out)).match()
        }
    }

    test("sarscov2 - fasta - build fai - stub") {
        options "-stub"
        when {
            workflow {
                """
                input[0] = params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta'
                input[1] = null
                """
            }
        }
        then {
            assert workflow.success
            assert snapshot(sanitizeOutput(workflow.out)).match()
        }
    }
}
