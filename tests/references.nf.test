def projectDir = new File('.').absolutePath

nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"

    def test_scenario = [
        [
            name: "-profile test --references nf-core/GRCh38_chr21.yml --genome null",
            params: [
                genome: null,
                references: 'https://raw.githubusercontent.com/nf-core/references-datasheets/latest/genomes/Homo_sapiens/nf-core/GRCh38_chr21.yml',
            ],
        ],
        [
            name: "-profile test --igenomes_ignore --genome nf-core/GRCh38_chr21 --references_datasheets_path genomes/Homo_sapiens",
            params: [
                genome: 'nf-core/GRCh38_chr21',
                igenomes_ignore: true,
                references_datasheets_path: 'https://raw.githubusercontent.com/nf-core/references-datasheets/latest/genomes/Homo_sapiens',
            ],
        ],
        [
            // CRAM decoding needs the reference from the datasheet, so success proves it resolved
            name: "-profile test --input test_cram_samplesheet.csv --references tests/assets/cram.yml --genome null with references_base_path substitution",
            params: [
                genome: null,
                input: 'https://raw.githubusercontent.com/nf-core/test-datasets/bamtofastq/samplesheet/test_cram_samplesheet.csv',
                references: "${projectDir}/tests/assets/cram.yml",
                references_base_path: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data',
            ],
        ],
        [
            name: "-profile test --references nf-core/GRCh38_chr21.yml",
            params: [
                references: 'https://raw.githubusercontent.com/nf-core/references-datasheets/latest/genomes/Homo_sapiens/nf-core/GRCh38_chr21.yml',
            ],
            failure: true,
            snapshot: 'stdout,stderr',
            snapshot_include: 'Use either --references or --genome',
        ],
    ]

    // Generate tests for each scenario
    test_scenario.each { scenario ->
        test(scenario.name, UTILS.getTest(scenario))
    }
}
